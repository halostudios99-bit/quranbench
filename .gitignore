# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/next/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# raw corpus downloads — checksummed, never committed (see sources/checksums.json)
packages/corpus-build/sources/*
!packages/corpus-build/sources/checksums.json

# non-redistributable translation editions — fetched at build time, never
# committed. Talal Itani's ClearQuran is CC BY-NC-ND 4.0; shipping it inside an
# MIT repo would create licensing ambiguity for forks. See LICENSING.md.
packages/corpus-build/out/*/translations/en-itani.jsonl
packages/corpus-build/out/*/translations/en-itani.LICENSE.md

# env
.env
.env.*
!.env.example
!.env.prod.example

# ci / ops artifacts
.lighthouseci/
backups/
zenodo-deposit/

# os / editor
.DS_Store
*.log
