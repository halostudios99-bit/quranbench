# Copy to .env.local for development. The compose file in docker/ provisions a
# matching Postgres and Redis. Never commit real secrets.

DATABASE_URL="postgresql://quranbench:quranbench@localhost:5432/quranbench?schema=public"

# Absolute origin for canonical URLs and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared rate-limit store. Optional in development: without it the app uses the
# in-process store limiter, which is correct for a single dev process. Required in
# production so the limit holds across replicas (see docs/deployment.md).
# REDIS_URL="redis://localhost:6379"

# Mail delivery. Without SMTP settings the console mailer logs verification and
# password-reset links to the server output — no mail server needed for dev. For a
# free captured-inbox dev setup, create an Ethereal account (https://ethereal.email)
# and paste its SMTP URL here. See src/server/mailer.ts and docs/deployment.md.
# MAILER="smtp"
# SMTP_URL="smtp://user:pass@smtp.ethereal.email:587"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="quranbench <no-reply@quranbench.com>"
