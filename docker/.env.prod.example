# Copy to docker/.env and fill in. Consumed by docker/compose.prod.yaml.
# Never commit the real docker/.env — it holds secrets.

# Public origin. Must match the domain Caddy serves and be https in production.
NEXT_PUBLIC_SITE_URL="https://quranbench.com"

# Domain Caddy obtains a TLS certificate for, and the ACME contact email.
SITE_DOMAIN="quranbench.com"
TLS_EMAIL="admin@quranbench.com"

# Postgres. POSTGRES_PASSWORD is required; the app and migrate services build
# DATABASE_URL from these.
POSTGRES_USER="quranbench"
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
POSTGRES_DB="quranbench"

# Mail (optional). Without these the app logs verification/reset links to the
# container logs. For real delivery set MAILER=smtp and an SMTP URL.
# MAILER="smtp"
# SMTP_URL="smtp://user:pass@smtp.provider.com:587"
# MAIL_FROM="quranbench <no-reply@quranbench.com>"

# Backups (used by scripts/backup.sh). Where dumps are written.
# BACKUP_DIR="/var/backups/quranbench"
